generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Link {
  id           String    @id @default(cuid())
  slug         String    @unique
  originalUrl  String
  title        String?
  password     String?
  expiresAt    DateTime?
  clicks       Int       @default(0)
  lastAccessed DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([createdAt])
}
